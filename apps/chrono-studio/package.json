{
  "name": "chrono-studio",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.21",
    "expo-haptics": "~58.0.7",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.22",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node --experimental-strip-types scripts/verify-format.ts",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:apk": "cd android && ./gradlew assembleRelease && echo android/app/build/outputs/apk/release/app-release.apk"
  },
  "private": true
}
